<Window x:Class="QI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QI — Qalos Intelligence" Height="750" Width="1150"
        MinHeight="600" MinWidth="900"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ── Scrollbar ─────────────────────────────────────────── -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#2E75B6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SView" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1" Style="{StaticResource SBar}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ───────────────────────────────────────────── -->
        <Style x:Key="TbStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#2E75B6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2E75B6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary button ────────────────────────────────────── -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2E75B6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F5A9C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#174880"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Danger button ─────────────────────────────────────── -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#6E1A1A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9B2424"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Success button ────────────────────────────────────── -->
        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#1A5C2E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27833F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Chip button ───────────────────────────────────────── -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Background" Value="#1A2233"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab item style ────────────────────────────────────── -->
        <Style x:Key="TabStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2E75B6"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C9D1D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header -->
            <RowDefinition Height="*"/>
            <!-- body -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" Background="#161B22"
                BorderBrush="#21262D" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2E75B6" CornerRadius="8" Padding="7,3" Margin="0,0,10,0">
                        <TextBlock Text="QI" FontFamily="Consolas" FontSize="15"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Qalos Intelligence" FontFamily="Segoe UI"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                        <TextBlock Text="Cybersecurity Awareness Bot — Part 3"
                                   FontFamily="Segoe UI" FontSize="10" Foreground="#8B949E"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#3FB950" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="Online"
                               FontFamily="Segoe UI" FontSize="11" Foreground="#8B949E"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ BODY ══════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- chat -->
                <ColumnDefinition Width="5"/>
                <!-- splitter -->
                <ColumnDefinition Width="360"/>
                <!-- side panel -->
            </Grid.ColumnDefinitions>

            <!-- ────────────── LEFT: CHAT ────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- name bar -->
                    <RowDefinition Height="*"/>
                    <!-- messages -->
                    <RowDefinition Height="Auto"/>
                    <!-- chips -->
                    <RowDefinition Height="Auto"/>
                    <!-- input -->
                </Grid.RowDefinitions>

                <!-- Name bar -->
                <Border x:Name="NameBar" Grid.Row="0" Background="#161B22"
                        BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameInput" Grid.Column="0"
                                 Style="{StaticResource TbStyle}"
                                 Margin="0,0,10,0"
                                 KeyDown="NameInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Start Chat"
                                Style="{StaticResource BtnPrimary}"
                                Click="StartChat_Click"/>
                    </Grid>
                </Border>

                <!-- Chat messages -->
                <ScrollViewer x:Name="ChatScroller" Grid.Row="1"
                              Style="{StaticResource SView}"
                              VerticalScrollBarVisibility="Auto"
                              Background="#0D1117" Padding="0,6">
                    <StackPanel x:Name="ChatPanel" Margin="16,6"/>
                </ScrollViewer>

                <!-- Quick chips -->
                <Border x:Name="ChipsBar" Grid.Row="2" Background="#0D1117"
                        BorderBrush="#21262D" BorderThickness="0,1,0,0"
                        Padding="12,6" Visibility="Collapsed">
                    <WrapPanel>
                        <Button Content="password safety" Style="{StaticResource ChipBtn}" Click="Chip_Click"/>
                        <Button Content="phishing"         Style="{StaticResource ChipBtn}" Click="Chip_Click"/>
                        <Button Content="safe browsing"    Style="{StaticResource ChipBtn}" Click="Chip_Click"/>
                        <Button Content="privacy"          Style="{StaticResource ChipBtn}" Click="Chip_Click"/>
                        <Button Content="malware"          Style="{StaticResource ChipBtn}" Click="Chip_Click"/>
                        <Button Content="start quiz"       Style="{StaticResource ChipBtn}" Click="Chip_Click"/>
                        <Button Content="show tasks"       Style="{StaticResource ChipBtn}" Click="Chip_Click"/>
                        <Button Content="activity log"     Style="{StaticResource ChipBtn}" Click="Chip_Click"/>
                    </WrapPanel>
                </Border>

                <!-- Input bar -->
                <Border x:Name="InputBar" Grid.Row="3" Background="#161B22"
                        BorderBrush="#21262D" BorderThickness="0,1,0,0"
                        Padding="16,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MessageInput" Grid.Column="0"
                                 Style="{StaticResource TbStyle}"
                                 Margin="0,0,10,0"
                                 KeyDown="MessageInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Send"
                                Style="{StaticResource BtnPrimary}"
                                Click="Send_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" Background="#21262D"
                          HorizontalAlignment="Stretch"/>

            <!-- ────────────── RIGHT: SIDE PANEL ────────────── -->
            <Grid Grid.Column="2" Background="#161B22">
                <TabControl Background="#161B22"
                             BorderBrush="#21262D" BorderThickness="0,1,0,0">

                    <!-- ── TASKS TAB ── -->
                    <TabItem Header="Tasks" Style="{StaticResource TabStyle}">
                        <Grid Background="#0D1117">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- add form -->
                                <RowDefinition Height="*"/>
                                <!-- task list -->
                            </Grid.RowDefinitions>

                            <!-- Add task form -->
                            <Border Grid.Row="0" Background="#161B22"
                                    BorderBrush="#21262D" BorderThickness="0,0,0,1"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="ADD CYBERSECURITY TASK"
                                               Foreground="#8B949E" FontFamily="Consolas"
                                               FontSize="10" Margin="0,0,0,8"/>
                                    <TextBox x:Name="TaskTitleInput"
                                             Style="{StaticResource TbStyle}"
                                             Margin="0,0,0,6"/>
                                    <TextBox x:Name="TaskDescInput"
                                             Style="{StaticResource TbStyle}"
                                             Height="55" TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ReminderDaysInput"
                                                 Style="{StaticResource TbStyle}"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="days reminder"
                                                   Foreground="#8B949E" FontFamily="Segoe UI"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button Content="Add Task"
                                            Style="{StaticResource BtnPrimary}"
                                            HorizontalAlignment="Stretch"
                                            Click="AddTask_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Task list -->
                            <ScrollViewer Grid.Row="1" Style="{StaticResource SView}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="TaskListPanel" Margin="10,8"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ── QUIZ TAB ── -->
                    <TabItem Header="Quiz" Style="{StaticResource TabStyle}">
                        <Grid Background="#0D1117" Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- header / score -->
                                <RowDefinition Height="*"/>
                                <!-- question area -->
                                <RowDefinition Height="Auto"/>
                                <!-- feedback -->
                                <RowDefinition Height="Auto"/>
                                <!-- action buttons -->
                            </Grid.RowDefinitions>

                            <!-- Quiz header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock x:Name="QuizHeaderText"
                                           Text="CYBERSECURITY QUIZ"
                                           Foreground="#8B949E" FontFamily="Consolas"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock x:Name="QuizProgressText"
                                           Text="Press Start to begin"
                                           Foreground="#58A6FF" FontFamily="Segoe UI"
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- Question + options -->
                            <ScrollViewer Grid.Row="1" Style="{StaticResource SView}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="QuizQuestionPanel"/>
                            </ScrollViewer>

                            <!-- Feedback -->
                            <Border x:Name="QuizFeedbackBorder" Grid.Row="2"
                                    Background="#161B22" CornerRadius="6"
                                    Padding="12,8" Margin="0,8,0,8"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="QuizFeedbackText"
                                           Foreground="#E6EDF3" FontFamily="Segoe UI"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Quiz buttons -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <Button x:Name="StartQuizBtn" Content="Start Quiz"
                                        Style="{StaticResource BtnPrimary}"
                                        Margin="0,0,8,0" Click="StartQuiz_Click"/>
                                <Button x:Name="NextQuestionBtn" Content="Next"
                                        Style="{StaticResource BtnSuccess}"
                                        Visibility="Collapsed" Click="NextQuestion_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- ── ACTIVITY LOG TAB ── -->
                    <TabItem Header="Activity Log" Style="{StaticResource TabStyle}">
                        <Grid Background="#0D1117">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#161B22"
                                    BorderBrush="#21262D" BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RECENT ACTIONS"
                                               Foreground="#8B949E" FontFamily="Consolas"
                                               FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LogCountText" Text=" (0)"
                                               Foreground="#58A6FF" FontFamily="Consolas"
                                               FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" Style="{StaticResource SView}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="LogPanel" Margin="10,8"/>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="#161B22"
                                    BorderBrush="#21262D" BorderThickness="0,1,0,0"
                                    Padding="12,8">
                                <Button Content="Refresh Log"
                                        Style="{StaticResource BtnPrimary}"
                                        HorizontalAlignment="Stretch"
                                        Click="RefreshLog_Click"/>
                            </Border>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
